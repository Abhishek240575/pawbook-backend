# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Neon PostgreSQL ───────────────────────────────────────────
# Get this from your Neon dashboard → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/pawbook?sslmode=require

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Bcrypt ────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── File uploads (Cloudinary / S3 — add later) ────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
